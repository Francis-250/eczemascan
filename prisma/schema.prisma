generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum ScanCondition {
  ECZEMA
  CONTACT_DERMATITIS
  PSORIASIS
  FUNGAL_INFECTION
  OTHER
}

enum ScanStatus {
  PENDING_REVIEW
  REVIEWED
  FLAGGED
}

enum ReviewVerdict {
  CONFIRMED
  CORRECTED
  INCONCLUSIVE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}


model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  role                String?
  banned              Boolean?  @default(false)
  banReason           String?
  banExpires          DateTime?
  phoneNumber         String?
  phoneNumberVerified Boolean?
  sessions            Session[]
  accounts            Account[]

  patientProfile       PatientProfile?
  dermatologistProfile DermatologistProfile?

  patientScans         Scan[]          @relation("PatientScans")
  dermatologistReviews ScanReview[]    @relation("DermatologistReviews")
  supportTickets       SupportTicket[] @relation("PatientTickets")
  handledTickets       SupportTicket[] @relation("HandledTickets")
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


model PatientProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth    DateTime?
  sex            String?
  skinType       String?
  allergyHistory Boolean   @default(false)
  familyHistory  Boolean   @default(false)
  location       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("patient_profile")
}

model DermatologistProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber       String             @unique
  specialty           String?
  hospitalAffiliation String?
  yearsOfExperience   Int?
  bio                 String?
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("dermatologist_profile")
}


model Scan {
  id                String          @id @default(cuid())
  imageUrl          String
  patientId         String
  patient           User            @relation("PatientScans", fields: [patientId], references: [id], onDelete: Cascade)

  aiCondition       ScanCondition
  aiConfidenceScore Float
  aiExplanation     String

  status            ScanStatus      @default(PENDING_REVIEW)

  recommendation    Recommendation?
  review            ScanReview?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([patientId])
  @@map("scan")
}

model ScanReview {
  id                 String        @id @default(cuid())
  scanId             String        @unique
  scan               Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  dermatologistId    String
  dermatologist      User          @relation("DermatologistReviews", fields: [dermatologistId], references: [id], onDelete: Cascade)

  verdict            ReviewVerdict
  correctedCondition ScanCondition?
  recommendationOk   Boolean       @default(true)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([dermatologistId])
  @@map("scan_review")
}

model Recommendation {
  id         String        @id @default(cuid())
  scanId     String        @unique
  scan       Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  condition  ScanCondition
  careAdvice String
  disclaimer String        @default("This is not a medical diagnosis. Please consult a dermatologist or healthcare professional.")

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("recommendation")
}

model CareGuideline {
  id        String        @id @default(cuid())
  condition ScanCondition @unique
  title     String
  advice    String

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("care_guideline")
}


model SupportTicket {
  id          String    @id @default(cuid())
  patientId   String
  patient     User      @relation("PatientTickets", fields: [patientId], references: [id], onDelete: Cascade)

  handledById String?
  handledBy   User?     @relation("HandledTickets", fields: [handledById], references: [id])

  subject     String
  resolved    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
  @@index([handledById])
  @@map("support_ticket")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action    String
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_log")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notification")
}